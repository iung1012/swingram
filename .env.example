# Frontend
# Use this only if you want the browser to call the API directly.
# In local dev, the browser can call the backend directly.
VITE_API_BASE_URL="http://127.0.0.1:5005"
API_BASE_URL="http://127.0.0.1:5005"
API_PROXY_TARGET="http://127.0.0.1:5005"
PUBLIC_API_BASE_URL="http://127.0.0.1:5005"

# Backend
DATABASE_URL="postgresql+psycopg://postgres:postgres@127.0.0.1:5432/brasa_swing"
JWT_SECRET_KEY="change-me-to-a-long-random-secret"
JWT_EXPIRY_SECONDS="2592000"
PORT="5005"

# Google OAuth
# Configure this same callback URL in Google Cloud Console:
# http://127.0.0.1:5005/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:5005/api/auth/oauth/google/callback"

# Storage
STORAGE_DIR="backend_data/storage"
STORAGE_SECRET="change-me-to-a-second-random-secret"
